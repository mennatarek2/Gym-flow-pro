{
  "name": "gymflowpro-frontend",
  "version": "1.0.0",
  "description": "HyMotion Admin Dashboard - Next.js Frontend",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node apps/web/server.js",
    "dev:admin": "npm run dev -w admin",
    "dev:platform": "npm run dev -w platform-console",
    "dev:turbo": "turbo run dev --parallel",
    "dev:web": "cd apps/web && npm run dev",
    "build": "npm run i18n:sync && turbo run build",
    "build:admin": "npm run build -w admin",
    "build:platform": "npm run build -w platform-console",
    "build:web": "cd apps/web && npm run build",
    "test:platform": "npm run test -w platform-console",
    "start": "cd apps/web && npm start",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "i18n:sync": "node scripts/i18n/sync-web-catalog.mjs",
    "i18n:validate": "node scripts/i18n/validate.mjs",
    "i18n:hardcoded": "node scripts/i18n/check-hardcoded.mjs",
    "i18n:inventory": "node scripts/i18n/scan-inventory.mjs",
    "i18n:test": "npm run test -w @gymflowpro/i18n",
    "brand:check": "node scripts/i18n/check-hymotion-branding.mjs",
    "i18n:ci": "npm run i18n:validate && npm run i18n:sync && npm run i18n:test && npm run i18n:hardcoded && npm run brand:check"
  },
  "devDependencies": {
    "turbo": "^1.10.0",
    "typescript": "^5.0.0"
  }
}
