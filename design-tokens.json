{
  "name": "HyMotion",
  "version": "1.0",
  "colors": {
    "charcoal": {
      "900": "#0D0D0D",
      "800": "#1A1A1A",
      "700": "#2A2A2A",
      "600": "#3A3A3A",
      "500": "#4A4A4A",
      "400": "#6B6B6B",
      "300": "#8C8C8C",
      "200": "#B0B0B0",
      "100": "#D4D4D4",
      "50": "#F0F0F0"
    },
    "lime": {
      "600": "#5EAF00",
      "500": "#7ACC00",
      "400": "#A0E040",
      "300": "#BEEC73",
      "200": "#D8F5A6",
      "100": "#EDFCD8",
      "glow": "rgba(160,224,64,0.25)"
    },
    "teal": {
      "700": "#0A4D4D",
      "600": "#0D6B6B",
      "500": "#148F8F",
      "400": "#3DB5B5",
      "300": "#70CECE",
      "200": "#A8E4E4",
      "100": "#D9F2F2"
    },
    "semantic": {
      "success": { "600": "#16A34A", "500": "#22C55E", "100": "#DCFCE7", "text": "#166534" },
      "warning": { "600": "#D97706", "500": "#F59E0B", "100": "#FEF3C7", "text": "#92400E" },
      "danger":  { "600": "#DC2626", "500": "#EF4444", "100": "#FEE2E2", "text": "#991B1B" },
      "info":    { "600": "#2563EB", "500": "#3B82F6", "100": "#DBEAFE", "text": "#1E40AF" },
      "frozen":  { "600": "#0891B2", "500": "#22D3EE", "100": "#CFFAFE", "text": "#155E75" },
      "pending": { "600": "#D97706", "500": "#FBBF24", "100": "#FEF3C7", "text": "#92400E" }
    },
    "surfaces": {
      "light": { "bg": "#FAFAFA", "s1": "#FFFFFF", "s2": "#F5F5F5", "s3": "#EBEBEB" },
      "dark":  { "bg": "#0D0D0D", "s1": "#1A1A1A", "s2": "#2A2A2A", "s3": "#3A3A3A" }
    },
    "text": {
      "light": { "primary": "#1A1A1A", "secondary": "#4A4A4A", "tertiary": "#8C8C8C" },
      "dark":  { "primary": "#F0F0F0", "secondary": "#B0B0B0", "tertiary": "#6B6B6B" }
    },
    "border": {
      "light": "#D4D4D4",
      "dark": "#4A4A4A"
    }
  },
  "typography": {
    "families": {
      "display": "'Cairo', sans-serif",
      "body": "'Cairo', 'Cairo', sans-serif",
      "arabic": "'Cairo', sans-serif"
    },
    "weights": {
      "light": 300,
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "scale": {
      "h1":    { "size": 36, "weight": 700, "lineHeight": 1.1, "font": "display" },
      "h2":    { "size": 28, "weight": 700, "lineHeight": 1.2, "font": "display" },
      "h3":    { "size": 22, "weight": 600, "lineHeight": 1.3, "font": "display" },
      "h4":    { "size": 18, "weight": 600, "lineHeight": 1.4, "font": "display" },
      "h5":    { "size": 15, "weight": 600, "lineHeight": 1.4, "font": "display" },
      "h6":    { "size": 13, "weight": 700, "letterSpacing": "0.8px", "textTransform": "uppercase", "font": "display" },
      "body":  { "size": 14, "weight": 400, "lineHeight": 1.6, "font": "body" },
      "caption": { "size": 12, "weight": 400, "lineHeight": 1.5, "font": "body" },
      "label": { "size": 13, "weight": 600, "font": "body" },
      "kpi":   { "size": 36, "weight": 700, "lineHeight": 1.1, "font": "display" }
    }
  },
  "breakpoints": {
    "sm": 640,
    "md": 768,
    "lg": 1024,
    "xl": 1280,
    "notes": {
      "sm": "Compact forms / stacked field rows",
      "md": "Phone to tablet (shell padding, wrapping toolbars)",
      "lg": "Tablet to desktop (restore page-local padding)",
      "xl": "Wide desktop; page CSS is source of truth above lg"
    }
  },
  "spacing": {
    "base": 4,
    "scale": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 28,
      "8": 32,
      "10": 40,
      "12": 48,
      "16": 64,
      "20": 80
    }
  },
  "radius": {
    "sm": 6,
    "md": 10,
    "lg": 16,
    "xl": 24,
    "pill": 9999,
    "full": "50%"
  },
  "shadows": {
    "1": "0 1px 2px rgba(0,0,0,0.06)",
    "2": "0 2px 8px rgba(0,0,0,0.08)",
    "3": "0 4px 16px rgba(0,0,0,0.12)",
    "4": "0 8px 32px rgba(0,0,0,0.18)",
    "glow": "0 0 20px rgba(160,224,64,0.25)"
  },
  "transitions": {
    "fast": "150ms ease",
    "base": "250ms ease",
    "slow": "400ms ease"
  }
}
